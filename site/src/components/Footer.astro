---
import DefaultFooter from '@astrojs/starlight/components/Footer.astro'

const { codeCommit } = Astro.locals.starlightRoute.entry.data
---

{codeCommit && (
  <p class="code-baseline" data-pagefind-ignore>
    代码基线
    <a href={`https://github.com/Cyenoch/cordis/commit/${codeCommit}`} aria-label={`查看核对过的代码 commit ${codeCommit}`}>
      <code>{codeCommit.slice(0, 7)}</code>
    </a>
  </p>
)}
<DefaultFooter />

<style>
  .code-baseline {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 3rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  code { font-family: var(--sl-font-mono); }
</style>

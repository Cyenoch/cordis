---
import DefaultHero from '@astrojs/starlight/components/Hero.astro'
import { Code, Icon } from '@astrojs/starlight/components'

const isHome = Astro.locals.starlightRoute.entry.id === ''
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const plugin = `sdk.Run(ctx, contract.Definition{
    ID: "counter",
    Start: func(ctx context.Context,
        scope contract.Scope) error {
        value := 0
        return sdk.Provide(scope,
            counterService,
            func(ctx context.Context,
                in Request) (Response, error) {
                value += in.Delta
                return Response{Value: value}, nil
            })
    },
})`
---

{isHome ? (
  <section class="cordis-hero" aria-labelledby="_top">
    <div class="hero-copy">
      <h1 id="_top" data-page-title>插件独立交付。<br />应用持续生长。</h1>
      <p>为 Go 应用构建可组合的插件系统。<br class="wide-break" />独立编译，动态加载，资源随生命周期归位。</p>
      <div class="hero-actions">
        <a class="start-link" href={`${base}/getting-started/`}>开始使用 <Icon name="right-arrow" size="1.1rem" /></a>
        <a class="source-link" href="https://github.com/Cyenoch/cordis">查看源码 <Icon name="github" size="1.1rem" /></a>
      </div>
      <div class="runtime-labels" aria-label="运行形式与许可">
        <span>Go SDK</span><span>Native</span><span>MIT</span>
      </div>
    </div>
    <div class="hero-code">
      <Code code={plugin} lang="go" title="counter.go · 服务定义片段" />
      <div class="package-route" aria-label="插件经宿主管理，运行于原生进程">
        <span>plugin.zip</span><Icon name="right-arrow" size="1rem" /><strong>Cordis Host</strong><Icon name="right-arrow" size="1rem" /><span>Native</span>
      </div>
    </div>
  </section>
) : <DefaultHero {...Astro.props} />}

<style>
  .cordis-hero {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: 3.5rem;
    align-items: center;
    padding: 3rem 0 4.5rem;
  }
  .hero-copy h1 {
    margin: 0;
    color: var(--sl-color-white);
    font-size: clamp(2.4rem, 3.6vw, 3.75rem);
    font-weight: 650;
    letter-spacing: -0.035em;
    line-height: 1.3;
    text-wrap: balance;
  }
  .hero-copy p {
    margin: 1.75rem 0 0;
    color: var(--sl-color-gray-2);
    font-size: 1.05rem;
    line-height: 1.9;
  }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 1.4rem; align-items: center; margin-top: 2rem; }
  .hero-actions a { display: inline-flex; gap: 0.6rem; align-items: center; font-size: 0.9rem; font-weight: 650; text-decoration: none; }
  .start-link { color: #fff; background: #0f766e; padding: 0.85rem 1.2rem; border-radius: 0.6rem; }
  .start-link:hover { background: #115e59; }
  .source-link { color: var(--sl-color-white); padding-block: 0.8rem; }
  .source-link:hover { color: var(--sl-color-text-accent); }
  .runtime-labels { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 1.75rem; color: var(--sl-color-gray-3); font-size: 0.75rem; }
  .runtime-labels span + span { border-inline-start: 1px solid var(--sl-color-gray-5); padding-inline-start: 1rem; }
  .hero-code { min-width: 0; transform: rotate(-1deg); }
  .hero-code :global(.expressive-code) { box-shadow: 0 20px 65px -25px #1e66652e; }
  .package-route { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 0.8rem; margin-top: 1.3rem; color: var(--sl-color-gray-2); font-size: 0.7rem; }
  .package-route strong { font-weight: 650; color: var(--sl-color-text-accent); }
  @media (max-width: 65rem) {
    .cordis-hero { gap: 2rem; }
    .hero-copy h1 { font-size: 2.65rem; }
    .wide-break { display: none; }
  }
  @media (max-width: 50rem) {
    .cordis-hero { grid-template-columns: 1fr; gap: 2.75rem; padding: 1.5rem 0 3rem; }
    .hero-copy h1 { font-size: 2.6rem; }
    .hero-copy p { font-size: 1rem; }
    .hero-code { transform: none; }
  }
</style>

{
  "schema": "cordis-go.contract/v1",
  "services": [
    {
      "name": "example.echo",
      "major": 1,
      "minor": 0,
      "methods": [
        {
          "name": "echo",
          "request": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "text": {"type": "string", "minLength": 1, "maxLength": 128},
              "sequence": {"type": "string", "format": "int64"},
              "payload": {"type": "string", "contentEncoding": "base64"},
              "note": {"type": "string", "nullable": true},
              "repeat": {"type": "integer", "minimum": 1, "maximum": 3}
            },
            "required": ["text", "sequence", "payload", "note"]
          },
          "response": {
            "type": "object",
            "properties": {
              "text": {"type": "string"},
              "sequence": {"type": "string", "format": "int64"}
            },
            "required": ["text", "sequence"]
          }
        },
        {
          "name": "choose",
          "request": {
            "oneOf": [
              {"type": "object", "properties": {"kind": {"type": "string", "const": "text"}, "text": {"type": "string"}}, "required": ["kind", "text"]},
              {"type": "object", "properties": {"kind": {"type": "string", "const": "count"}, "count": {"type": "integer", "minimum": 0}}, "required": ["kind", "count"]}
            ],
            "discriminator": {"propertyName": "kind"}
          },
          "response": {"type": "array", "items": {"type": "string"}, "maxItems": 10}
        }
      ]
    }
  ]
}

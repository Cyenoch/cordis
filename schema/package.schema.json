            "maxLength": 200,
            "pattern": "^(?!/)(?!.*(?:\\.\\.|//))[A-Za-z0-9._/-]+(?<!/)$"
          },
          "requires": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "object",
              "properties": {
                "requirement": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512,
                      "pattern": "^(?!/)(?!.*//)[A-Za-z0-9._/-]+(?<!/)$"

                    "name",
                    "major",
                    "minMinor",
                    "maxMinor"
                  ],
                  "additionalProperties": false
                },
                "contract": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "requirement",
                "contract"
              ],
              "additionalProperties": false
            },
            "maxItems": 10000
          },
          "provides": {
            "type": [
              "array",
              "null"
            ],

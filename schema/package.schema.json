{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cordis-go.dev/package.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "cordis-go.package/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?!/)(?!.*(?:\\.\\.|//))[A-Za-z0-9._/-]+(?<!/)$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?!/)(?!.*(?:\\.\\.|//))[A-Za-z0-9._/-]+(?<!/)$"
    },
    "protocol": {
      "type": "object",
      "properties": {
        "major": {
          "const": 1
        },
        "minMinor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "maxMinor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "requiredFeatures": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "enum": [
              "cancel",
              "parent",
              "events",
              "children",
              "subscriptions"
            ]
          },
          "maxItems": 10000
        }
      },
      "required": [
        "major",
        "minMinor",
        "maxMinor"
      ],
      "additionalProperties": false
    },
    "definitions": {
      "type": "array",
      "minItems": 1,

              },
              "path": {
                "type": "string"
              }
            },
            "required": [
              "os",
              "arch",
              "path"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "kind",
        "artifacts"
      ],
      "additionalProperties": false
    },
    "dependencies": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,

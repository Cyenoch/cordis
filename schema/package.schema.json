              },
              "max": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
              }
            },
            "required": [
              "id",
              "min",
              "max"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^(?!/)(?!.*(?:\\.\\.|//))[A-Za-z0-9._/-]+(?<!/)$"
              },
              "range": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "range"
            ],
            "additionalProperties": false
          }
        ]
      },
      "maxItems": 10000

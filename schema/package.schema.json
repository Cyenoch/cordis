                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                },
                "minor": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                }
              },
              "required": [
                "name",
                "major",
                "minor"
              ],
              "additionalProperties": false
            },
            "maxItems": 10000
          },
          "configSchema": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "requires",
          "provides",
          "configSchema"
        ],
        "additionalProperties": false
      }
    },
    "defaultDefinition": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?!/)(?!.*(?:\\.\\.|//))[A-Za-z0-9._/-]+(?<!/)$"
    },
    "runtime": {
      "type": "object",
      "properties": {
        "kind": {

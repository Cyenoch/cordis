{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cordis-go.dev/session.schema.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "cordis-go.session/v1"
        },
        "kind": {
          "const": "request"
        },
        "activation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "id": {
          "type": "string",
          "pattern": "^[hg]:[1-9][0-9]*$",
          "maxLength": 128
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "payload": {},
        "deadlineMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120000
        },
        "parent": {
          "type": "string",
          "pattern": "^[hg]:[1-9][0-9]*$",
          "maxLength": 128
        }
      },
      "required": [
        "schema",
        "kind",
        "activation",
        "id",
        "method",
        "payload",
        "deadlineMs"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "cordis-go.session/v1"
        },
        "kind": {
          "const": "response"
        },
        "activation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "id": {
          "type": "string",
          "pattern": "^[hg]:[1-9][0-9]*$",
          "maxLength": 128
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "payload": {}
      },
      "required": [
        "schema",
        "kind",
        "activation",
        "id",
        "method",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "cordis-go.session/v1"
        },
        "kind": {
          "const": "response"
        },
        "activation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "id": {
          "type": "string",
          "pattern": "^[hg]:[1-9][0-9]*$",
          "maxLength": 128
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "enum": [
                "invalid_message",
                "incompatible",
                "not_ready",
                "denied",
                "timeout",
                "canceled",
                "reentrant_call",
                "plugin_failed",
                "internal",
                "conflict",
                "superseded"
              ]
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema",
        "kind",
        "activation",
        "id",
        "method",
        "error"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "cordis-go.session/v1"
        },
        "kind": {
          "const": "cancel"
        },
        "activation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "id": {
          "type": "string",
          "pattern": "^[hg]:[1-9][0-9]*$",
          "maxLength": 128
        }
      },
      "required": [
        "schema",
        "kind",
        "activation",
        "id"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "initialize": {
      "type": "object",
      "properties": {
        "identity": {
          "type": "object",
          "properties": {
            "package": {
              "type": "string"
            },
            "entry": {
              "type": "string"
            },
            "activation": {
              "type": "string"
            },
            "digest": {
              "type": "string"
            }
          },
          "required": [
            "package",
            "entry",
            "activation",
            "digest"
          ],
          "additionalProperties": false
        },
        "protocol": {
          "type": "object",
          "properties": {
            "major": {
              "const": 1
            },
            "minMinor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "maxMinor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "requiredFeatures": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "enum": [
                  "cancel",
                  "parent",
                  "events",
                  "children",
                  "subscriptions"
                ]
              },
              "maxItems": 10000
            }
          },
          "required": [
            "major",
            "minMinor",
            "maxMinor"
          ],
          "additionalProperties": false
        },
        "definition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^(?!/)(?!.*(?:\\.\\.|//))[A-Za-z0-9._/-]+(?<!/)$"
        },
        "config": {},
        "frameBytes": {
          "type": "integer",
          "minimum": 4096,
          "maximum": 1048576
        }
      },
      "required": [
        "frameBytes",
        "identity",
        "protocol",
        "definition",
        "config"
      ],
      "additionalProperties": false
    },
    "registration": {
      "type": "object",
      "properties": {
        "minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "features": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "maxItems": 10000
        },
        "services": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^(?!/)(?!.*//)[A-Za-z0-9._/-]+(?<!/)$"
              },
              "major": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "minor": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              }
            },
            "required": [
              "name",
              "major",
              "minor"
            ],
            "additionalProperties": false
          },
          "maxItems": 10000
        },
        "frameBytes": {
          "type": "integer",
          "minimum": 4096,
          "maximum": 1048576
        }
      },
      "required": [
        "frameBytes",
        "minor",
        "features",
        "services"
      ],
      "additionalProperties": false
    },
    "callToGuest": {
      "type": "object",
      "properties": {
        "service": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^(?!/)(?!.*//)[A-Za-z0-9._/-]+(?<!/)$"
            },
            "major": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "minor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          },
          "required": [
            "name",
            "major",
            "minor"
          ],
          "additionalProperties": false
        },
        "input": {},
        "cleanup": {
          "type": "boolean"
        }
      },
      "required": [
        "service",
        "input",
        "cleanup"
      ],
      "additionalProperties": false
    },
    "callToHost": {
      "type": "object",
      "properties": {
        "required": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^(?!/)(?!.*//)[A-Za-z0-9._/-]+(?<!/)$"
            },
            "major": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "minMinor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "maxMinor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          },
          "required": [
            "name",
            "major",
            "minMinor",
            "maxMinor"
          ],
          "additionalProperties": false
        },
        "input": {}
      },
      "required": [
        "required",
        "input"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "input": {},
        "mode": {
          "enum": [
            "sequential",
            "parallel",
            "first"
          ]
        }
      },
      "required": [
        "name",
        "input",
        "mode"
      ],
      "additionalProperties": false
    },
    "activationPublish": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "activationRetire": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "serviceKey": {
      "type": "string",
      "pattern": "^[\\s\\S]+@(0|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[01][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[01][0-9]{2}|42949672[0-8][0-9]|429496729[0-5])$"
    },
    "child": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^(?!.*\\.\\.)[A-Za-z0-9._-]+$"
        },
        "definition": {
          "$ref": "#/$defs/initialize/properties/definition"
        },
        "config": {},
        "isolate": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/serviceKey"
          },
          "uniqueItems": true,
          "maxItems": 10000
        }
      },
      "required": [
        "id",
        "definition",
        "config"
      ],
      "additionalProperties": false
    },
    "subscriptionID": {
      "type": "string",
      "maxLength": 149,
      "pattern": "^[\\s\\S]+/([1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$"
    },
    "subscriptionOptions": {
      "type": "object",
      "properties": {
        "once": {
          "type": "boolean"
        },
        "prepend": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "subscription": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/subscriptionID"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "$ref": "#/$defs/subscriptionOptions"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "subscriptionCancel": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/subscriptionID"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "subscriptionState": {
      "type": "object",
      "properties": {
        "inactive": {
          "const": true
        }
      },
      "required": [
        "inactive"
      ],
      "additionalProperties": false
    },
    "eventDelivery": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/subscriptionID"
        },
        "input": {}
      },
      "required": [
        "id",
        "input"
      ],
      "additionalProperties": false
    },
    "eventResult": {
      "type": "object",
      "properties": {
        "handled": {
          "type": "boolean"
        },
        "value": {}
      },
      "required": [
        "handled"
      ],
      "additionalProperties": false
    }
  }
}
